<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      Local embedded devices frequently expose HTTP endpoints without TLS. The application does
      not add user CAs and trusts only the platform system store for TLS connections. Operators
      should still prefer HTTPS/WSS whenever the device supports it.
    -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
